{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://linkdo.onrender.com/api/:path*" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/:slug([a-zA-Z0-9_-]{4,})", "destination": "https://linkdo.onrender.com/:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}